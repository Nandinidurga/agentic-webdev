# ==============================================================================
# Agentic IDE Backend - Environment Configuration Template
# ==============================================================================

# --- Primary High-Speed LLM (Groq Cloud) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- Fallback Resilient LLM (Google Gemini) ---
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# --- Provider Override ('groq' or 'gemini') ---
LLM_PROVIDER=groq

# --- HuggingFace Token (Optional) ---
HF_TOKEN=your_huggingface_token_optional
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_optional

# --- Code Execution Sandboxing (Optional) ---
E2B_API_KEY=your_e2b_api_key_optional
