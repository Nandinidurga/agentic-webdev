# ==============================================================================
# Agentic IDE - Environment Configuration Template
# Copy this file to .env and backend/.env and populate your secret keys.
# ==============================================================================

# --- Primary High-Speed LLM (Groq Cloud) ---
# Obtain from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- Fallback Resilient LLM (Google Gemini) ---
# Obtain from https://aistudio.google.com
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# --- Provider Selection & Generation Limits ---
# Optional: force a specific provider ('groq' or 'gemini'). Defaults to auto-resilience (Groq with Gemini fallback)
LLM_PROVIDER=groq
# Output token ceiling per generation call (default: 8192)
MAX_TOKENS=8192

# --- Local & Semantic Search (HuggingFace Embeddings) ---
# Optional HuggingFace user access token for higher rate limits on hub downloads
HF_TOKEN=your_huggingface_token_optional
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_optional

# --- Code Execution Sandboxing (Optional) ---
# E2B Sandbox API Key if remote Python/Node execution is enabled
E2B_API_KEY=your_e2b_api_key_optional

# --- Agentic Loop Semantics & Healer Controls ---
# Total allowed coder runs before terminating the self-healing loop (default: 3)
MAX_ATTEMPTS=3
# Optional regex AST/regex auto-healer in reviewer (0 = off by default; 1 = enabled)
HEAL_REGEX=0

# --- RAG Retrieval & Context Budgeting ---
# Number of chunks retrieved per domain (default: 3)
RAG_K=3
# Minimum relevance score threshold (0.0 to 1.0, default: 0.0)
RAG_SCORE_THRESHOLD=0.0
# Maximum token ceiling for RAG context in coder prompt (default: 2500)
MAX_CONTEXT_TOKENS=2500

# --- Security, Rate Limiting & Timeouts ---
# Allowed frontend origins for CORS (comma-separated, no wildcards when using credentials)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generation endpoint rate limit
RATE_LIMIT=10/minute
# Generation execution timeout in seconds
GENERATION_TIMEOUT=120
# Maximum prompt character length
MAX_PROMPT_LENGTH=5000

# --- Service Ports & Client URLs ---
FASTAPI_PORT=8000
FRONTEND_PORT=3000
EXPRESS_PORT=5000

# Next.js Client Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_EXPRESS_URL=http://localhost:5000
