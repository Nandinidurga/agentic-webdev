# ==============================================================================
# Agentic Full-Stack Web Development Studio - Environment Configuration
# ==============================================================================

# --- LLM Provider Credentials ---
# Option A: Groq (Recommended for rapid code generation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Option B: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Model Generation Parameters
MAX_TOKENS=8192
TEMPERATURE=0.2

# --- Cognitive Loop & Validation Semantics ---
# Maximum total coder generation runs before stopping (default: 3)
MAX_ATTEMPTS=3

# Regex Auto-Healer Flag (0 = disabled, 1 = enabled, default: 0)
# When disabled, AST & static validators guide the LLM to fix syntax/routes naturally.
HEAL_REGEX=0

# --- Vector Database & RAG Configuration ---
# Persistence directory for Chroma vector store
CHROMA_PERSIST_DIRECTORY=./chroma_db
# Collection name for ingested technical documentation
CHROMA_COLLECTION_NAME=webdev_docs
# Ingestion chunking configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# Number of chunks retrieved per query (default: 3)
RAG_K=3
# Minimum relevance score threshold (0.0 to 1.0, default: 0.0)
RAG_SCORE_THRESHOLD=0.0
# Maximum token ceiling for RAG context in coder prompt (default: 2500)
MAX_CONTEXT_TOKENS=2500

# --- Security, Rate Limiting & Timeouts ---
# Allowed frontend origins for CORS (comma-separated, no wildcards when using credentials)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generation endpoint rate limit
RATE_LIMIT=10/minute
# Generation execution timeout in seconds (per-attempt budget, default: 180)
GENERATION_TIMEOUT=180
# Maximum prompt character length
MAX_PROMPT_LENGTH=5000

# --- Service Ports & Client URLs ---
FASTAPI_PORT=8000
FRONTEND_PORT=3000
EXPRESS_PORT=5000

# Next.js Client Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_EXPRESS_URL=http://localhost:5000
