# ==============================================================================
# Agentic IDE - Environment Configuration Template
# Copy this file to .env and backend/.env and populate your secret keys.
# ==============================================================================

# --- Primary High-Speed LLM (Groq Cloud) ---
# Obtain from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- Fallback Resilient LLM (Google Gemini) ---
# Obtain from https://aistudio.google.com
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# --- Provider Selection ---
# Optional: force a specific provider ('groq' or 'gemini'). Defaults to auto-resilience (Groq with Gemini fallback)
LLM_PROVIDER=groq

# --- Local & Semantic Search (HuggingFace Embeddings) ---
# Optional HuggingFace user access token for higher rate limits on hub downloads
HF_TOKEN=your_huggingface_token_optional
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_optional

# --- Code Execution Sandboxing (Optional) ---
# E2B Sandbox API Key if remote Python/Node execution is enabled
E2B_API_KEY=your_e2b_api_key_optional

# --- Service Ports ---
FASTAPI_PORT=8000
FRONTEND_PORT=3000
EXPRESS_PORT=5000
